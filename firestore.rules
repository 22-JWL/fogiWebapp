rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 인증된 사용자만 접근 가능
    function isAuthenticated() {
      return request.auth != null;
    }

    // 본인 문서인지 확인
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // 매니저인지 확인
    function isManager() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    // 사용자 컬렉션
    match /users/{userId} {
      // 읽기: 인증된 모든 사용자 (멤버 목록 조회, 참석률 계산 등)
      allow read: if isAuthenticated();

      // 생성: 인증된 사용자가 본인 문서 생성
      allow create: if isOwner(userId);

      // 수정: 본인이 fcmToken, name 등 수정 가능 (단 role은 제외 — 스스로 매니저가 될 수 없다)
      // 역할(role) 변경은 매니저만 가능
      allow update: if (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        (isManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));

      // 삭제: 매니저만
      allow delete: if isManager();
    }

    // 알림 컬렉션
    match /notifications/{notificationId} {
      // 읽기: 인증된 사용자
      allow read: if isAuthenticated();

      // 생성: 매니저만
      allow create: if isManager();

      // 수정/삭제: 불가 (Cloud Functions에서만 처리)
      allow update, delete: if false;
    }

    // 일정 컬렉션
    match /schedules/{scheduleId} {
      // 읽기: 인증된 사용자
      allow read: if isAuthenticated();

      // 생성/수정/삭제: 매니저만
      allow create, update, delete: if isManager();
    }

    // 출석 컬렉션 (매니저가 관리하는 실제 출석)
    match /attendances/{attendanceId} {
      // 읽기: 인증된 사용자
      allow read: if isAuthenticated();

      // 생성/수정/삭제: 매니저만
      allow create, update, delete: if isManager();
    }

    // 마니또 컬렉션
    // manito/{YYYY-MM}          = 설정 문서 (참가자 명단, 전원 읽기 가능)
    // manito/{YYYY-MM}_{userId} = 배정 문서 (본인과 매니저만 읽기 가능)
    match /manito/{docId} {
      // 읽기: 매니저는 전부, 부원은 설정 문서와 본인 배정 문서만
      allow read: if isManager() ||
        (isAuthenticated() &&
          (docId.split('_').size() == 1 || docId.split('_')[1] == request.auth.uid));

      // 생성/수정/삭제: 매니저만
      allow write: if isManager();
    }

    // RSVP 컬렉션 (부원이 직접 입력하는 참석 예정)
    match /rsvps/{rsvpId} {
      // 읽기: 인증된 사용자
      allow read: if isAuthenticated();

      // 생성/수정: 본인 RSVP만 (rsvpId = scheduleId_userId 형식)
      allow create, update: if isAuthenticated() &&
        rsvpId.split('_')[1] == request.auth.uid;

      // 삭제: 본인만
      allow delete: if isAuthenticated() &&
        rsvpId.split('_')[1] == request.auth.uid;
    }
  }
}
